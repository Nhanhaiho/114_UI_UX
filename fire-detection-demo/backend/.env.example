# Cấu hình đường dẫn mô hình (weights)
MODEL_PATH=weights/best.pt

# Thư mục chứa mã nguồn kiến trúc tùy chỉnh (ví dụ module Spatial Relations Co-Attention: src_coattention.py)
MODEL_CODE_DIR=model_code

# Thiết bị tính toán: để trống sẽ tự động chọn CUDA nếu có, hoặc điền 'cpu', 'cuda:0'
DEVICE=

# Kích thước ảnh đầu vào của mô hình
IMGSZ=640

# Ngưỡng tin cậy mặc định
CONF_THRESHOLD=0.25

# Giới hạn kích thước ảnh tải lên (MB)
MAX_IMAGE_SIZE_MB=20

