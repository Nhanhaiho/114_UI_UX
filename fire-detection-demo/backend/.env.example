# =============================================================================
# FIRE DETECTION STUDIO - BACKEND ENVIRONMENT VARIABLES (backend/.env)
# =============================================================================
# Sao chép file này thành backend/.env rồi điền thông tin thật của bạn.
# Khi chạy `python run.py`, backend tự động đọc trực tiếp file `backend/.env`.
# TUYỆT ĐỐI KHÔNG commit file `.env` chứa mật khẩu, App Password hay secret keys.

# 1. Cấu hình Mô hình AI (YOLO / SRC)
MODEL_PATH=weights/plain_mixedneg_s42_last.pt
MODEL_CODE_DIR=model_code
# Thiết bị tính toán: để trống để tự động chọn CUDA nếu có, hoặc điền 'cpu', 'cuda:0'
DEVICE=
IMGSZ=640
CONF_THRESHOLD=0.25
MAX_IMAGE_SIZE_MB=20

# 2. Cấu hình Supabase thật (Xác thực OTP & Lưu tùy chọn Postgres)
# Lấy từ Supabase Dashboard -> Project Settings -> API
# Cần điền để xác thực tài khoản thật (thay thế chế độ Mock Auth @example.com):
#   - SUPABASE_URL
#   - SUPABASE_ANON_KEY (dùng gọi /auth/v1/user kiểm tra JWT và lấy email đã xác minh)
#   - SUPABASE_SERVICE_ROLE_KEY (chỉ lưu ở backend để đồng bộ bảng user_email_preferences & email_dispatches)
#   - SUPABASE_JWT_SECRET (tùy chọn, dùng dự phòng giải mã JWT cục bộ; lấy tại Project Settings -> API -> JWT Secret)
# Lưu ý: Frontend cũng cần điền VITE_SUPABASE_URL và VITE_SUPABASE_ANON_KEY trong frontend/.env.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_secret...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# -----------------------------------------------------------------------------
# HƯỚNG DẪN 1: ĐĂNG NHẬP OTP BẰNG SUPABASE AUTH
# - Supabase Auth tự gửi mã OTP 6 số khi người dùng bấm "Đăng nhập" trên web.
# - Bạn có thể dùng dịch vụ email mặc định của Supabase hoặc cấu hình Custom SMTP
#   trong Supabase Dashboard -> Project Settings -> Auth -> SMTP Settings.
# -----------------------------------------------------------------------------

# 3. Cấu hình Gmail SMTP thật (DO FASTAPI SERVER GỬI EMAIL THỬ & CẢNH BÁO LỬA)
# -----------------------------------------------------------------------------
# HƯỚNG DẪN 2: ĐỂ TẮT MOCK VÀ BẬT SMTP GMAIL THẬT
# - Đặt SMTP_MOCK=false và SMTP_ENABLED=true
# - Bật xác thực 2 bước (2-Step Verification) trên tài khoản Google của bạn.
# - Tạo Mật khẩu ứng dụng (App Password) 16 ký tự tại:
#   https://myaccount.google.com/apppasswords
# - Điền Gmail của bạn vào SMTP_USER và SMTP_FROM_EMAIL.
# - Điền App Password 16 ký tự vào SMTP_PASSWORD (không dùng mật khẩu đăng nhập Gmail).
# - Giữ SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true (hoặc port 465 SSL).
# - Nếu chỉ muốn kiểm thử giả lập không gửi thư thật, đặt SMTP_MOCK=true.
# -----------------------------------------------------------------------------
SMTP_MOCK=false
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Fire Detection Studio"
SMTP_USE_TLS=true

# Giới hạn tần suất bấm nút 'Gửi email thử' (giây) để tránh spam
TEST_EMAIL_COOLDOWN_SECONDS=60
