# =============================================================================
# FIRE DETECTION STUDIO - FRONTEND ENVIRONMENT VARIABLES (.env)
# =============================================================================

# 1. Địa chỉ máy chủ API FastAPI backend (khi chạy dev cục bộ bằng Vite)
# Khi build qua Docker Compose, biến này được truyền rỗng ("") để gọi /api/... cùng origin qua Nginx.
VITE_API_BASE_URL=http://localhost:8000

# 2. Cấu hình Supabase Auth (Xác thực đăng nhập bằng mã OTP qua email)
# Lấy từ Supabase Dashboard: Project Settings -> API
# Lưu ý: Chỉ dùng ANON KEY công khai tại frontend. Tuyệt đối KHÔNG đưa service_role key vào đây.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key...

# GHI CHÚ VỀ CHẾ ĐỘ PHÁT TRIỂN / THỬ NGHIỆM:
# Nếu để trống VITE_SUPABASE_URL và VITE_SUPABASE_ANON_KEY, giao diện web sẽ
# tự động chạy ở chế độ "Mock Auth" để bạn có thể kiểm thử toàn bộ chức năng
# đăng nhập (mã OTP mặc định: 123456), bật/tắt email cảnh báo và gửi email thử
# mà không cần thiết lập tài khoản Supabase bên ngoài.
